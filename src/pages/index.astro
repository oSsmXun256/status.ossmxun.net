---
import Layout from '../layouts/Layout.astro';
import services from '../data/services.json';
const groups = [...new Set(services.map(service => service.group))];
---
<Layout title="稼働状況" description="ossmxun.net のサービス稼働状況">
  <section class="overview" aria-labelledby="page-title">
    <h1 id="page-title">稼働状況</h1>
    <div id="overall" class="overall" data-state="unknown" role="status" aria-live="polite"><span class="signal" aria-hidden="true"></span><p class="overall-label" id="overall-label">稼働状況は不明です</p></div>
    <p class="summary">最終更新 <time id="last-updated">—</time></p>
    <p class="notice" id="data-error" role="status" aria-live="polite"></p>
    <noscript><p class="notice">現在、稼働情報を取得できません</p></noscript>
  </section>
  <section id="current-section" class="section" aria-labelledby="current-title" hidden><h2 id="current-title">現在の障害・メンテナンス</h2><div id="current-events" class="events"></div></section>
  <section class="section" aria-labelledby="services-title"><h2 id="services-title">サービス別の状況</h2>
    {groups.map(group => <div class="service-group"><h3>{group}</h3><ul class="services">{services.filter(service => service.group === group).map(service => <li class="service" data-service={service.id}><div class="service-name"><span>{service.name}</span>{group !== 'Discord Bot' && <a href={`https://${service.host}/`}>{service.host}</a>}</div><div class="service-data"><span class="uptime" data-uptime>—</span><span class="badge" data-state="unknown" data-badge>不明</span></div></li>)}</ul></div>)}
  </section>
  <section id="history-section" class="section" aria-labelledby="history-title" hidden><h2 id="history-title">障害履歴</h2><div id="history-events" class="events"></div></section>
  <p class="maintenance-link"><a href="/maintenance">メンテナンス案内</a></p>
  <script>import '../scripts/status.ts';</script>
</Layout>
